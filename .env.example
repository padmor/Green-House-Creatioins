# Copy to .env.local (never commit real values)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Used solely to store public enquiries. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Email via Resend (optional; enquiries are still saved without it)
RESEND_API_KEY=
EMAIL_FROM="GBC <enquiries@your-verified-domain>"
# Comma-separated managers who are emailed about each new enquiry
ENQUIRY_NOTIFY_EMAILS=

# Public contact details shown on the website
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Optional: WhatsApp number, international format (e.g. 233241234567). Shows a WhatsApp button on phones.
NEXT_PUBLIC_CONTACT_WHATSAPP=
